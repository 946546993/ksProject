{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestionDraft",
  "description": "LLM 生成题目的结构化校验 Schema（PRD 附录 14.2）",
  "type": "object",
  "required": ["stem", "options", "correctAnswer", "explanation", "knowledgePoint", "selfDifficulty"],
  "properties": {
    "stem": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["key", "text"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-E]$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "correctAnswer": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "pattern": "^[A-E]$" },
      "uniqueItems": true
    },
    "explanation": {
      "type": "string",
      "minLength": 20
    },
    "knowledgePoint": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "selfDifficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  }
}
